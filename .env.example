# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Lock screen sign-in (src/lib/oauth.ts, dev/oauth-plugin.ts) ---
# Each provider below needs a public Client ID (VITE_-prefixed — safe to
# expose, it ends up in the built client bundle, same as any VITE_ var) and
# a private Client Secret (never VITE_-prefixed — that would bundle it into
# client-side JS, where anyone could read it out of the built files; it's
# only usable from dev/oauth-plugin.ts's server-side token exchange).

# VITE_LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET: the lock screen's
# LinkedIn button. Get these from your LinkedIn app at
# https://www.linkedin.com/developers/apps.
VITE_LINKEDIN_CLIENT_ID="MY_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="MY_LINKEDIN_CLIENT_SECRET"

# VITE_GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: the lock screen's GitHub
# button.
#   1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App.
#   2. Homepage URL: http://localhost:3001 (or your real deployed URL).
#   3. Authorization callback URL: same as Homepage URL, no trailing slash
#      (must match exactly what the app actually redirects with — see
#      redirectUri() in src/lib/oauth.ts).
#   4. Register, copy the Client ID into VITE_GITHUB_CLIENT_ID below.
#   5. Click "Generate a new client secret", copy it into GITHUB_CLIENT_SECRET.
VITE_GITHUB_CLIENT_ID="MY_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="MY_GITHUB_CLIENT_SECRET"

# VITE_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: the lock screen's Google
# button.
#   1. Go to https://console.cloud.google.com/apis/credentials (create a
#      project first if you don't have one).
#   2. If prompted, configure the OAuth consent screen first (External user
#      type is fine for a personal portfolio) — app name, your email, done.
#   3. Create Credentials → OAuth client ID → Application type: Web application.
#   4. Authorized redirect URIs: http://localhost:3001 (or your real deployed
#      URL) — no trailing slash, must match exactly what the app redirects
#      with (see redirectUri() in src/lib/oauth.ts).
#   5. Create — copy the Client ID into VITE_GOOGLE_CLIENT_ID and the Client
#      Secret into GOOGLE_CLIENT_SECRET below.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# VITE_MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET: the lock screen's
# Microsoft button.
#   1. Go to https://portal.azure.com/ → search "App registrations" → New
#      registration.
#   2. Name it anything. Supported account types: "Accounts in any
#      organizational directory and personal Microsoft accounts" — this is
#      what makes the `common` tenant endpoint in src/lib/oauth.ts work for
#      both work/school and personal (outlook.com/hotmail.com) accounts.
#   3. Redirect URI: platform "Web", http://localhost:3001 (or your real
#      deployed URL) — no trailing slash, must match exactly what the app
#      redirects with (see redirectUri() in src/lib/oauth.ts).
#   4. Register — copy "Application (client) ID" into
#      VITE_MICROSOFT_CLIENT_ID below.
#   5. Certificates & secrets → New client secret → copy the Value (shown
#      once) into MICROSOFT_CLIENT_SECRET below.
#   6. API permissions should already list Microsoft Graph → User.Read
#      (delegated) by default — that's the only scope this needs.
VITE_MICROSOFT_CLIENT_ID="MY_MICROSOFT_CLIENT_ID"
MICROSOFT_CLIENT_SECRET="MY_MICROSOFT_CLIENT_SECRET"

# VITE_YOUTUBE_API_KEY: the dock's Spotify-clone window (src/components/
# apps/SpotifyApp.tsx) — search only, called directly from the browser via
# searchYouTube() in src/lib/youtube-player.tsx against YouTube Data API v3.
# VITE_-prefixed ON PURPOSE, unlike every other secret in this file — a
# YouTube Data API key restricted by HTTP referrer (step 3 below) is
# specifically designed for client-side use; the referrer check *is* the
# security boundary here, not secrecy. Proxying it server-side instead
# doesn't work: a server-side fetch carries no browser Referer header at
# all, so Google's API rejects it outright (`referer <empty>` blocked) —
# confirmed hitting this directly. Actual playback (once a track is picked)
# goes through the official YouTube IFrame Player instead
# (src/lib/youtube-player.tsx) — no key needed there, it's just an embed.
#   1. Same Google Cloud project as your Google OAuth client above (or a
#      new one) → https://console.cloud.google.com/apis/library — enable
#      "YouTube Data API v3".
#   2. https://console.cloud.google.com/apis/credentials → Create
#      Credentials → API key. No redirect URI needed (this isn't OAuth).
#   3. Edit the key → Application restrictions → Websites → add your
#      origins with a trailing slash, e.g. http://localhost:3001/ and
#      https://your-deployed-domain/ — this is what makes it safe to expose
#      client-side: only requests whose Referer matches one of these are
#      accepted.
#   4. Free tier is 10,000 quota units/day; a search costs 100 units — about
#      100 searches/day shared across every visitor, not per-visitor. Fine
#      for normal traffic, but a heavy day could exhaust it before it
#      resets.
VITE_YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# GMAIL_USER / GMAIL_APP_PASSWORD: the Email window's contact form
# (src/components/apps/EmailApp.tsx, sent via dev/email-plugin.ts). Never
# prefix these with VITE_ — same reason as LINKEDIN_CLIENT_SECRET above.
# GMAIL_APP_PASSWORD is NOT your regular Gmail password — Google blocks
# plain-password SMTP login entirely now. Generate a 16-character App
# Password instead (requires 2-Step Verification to be on first):
#   1. Turn on 2-Step Verification on your Google Account, if not already on:
#      https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Name it anything (e.g. "Portfolio contact form") and click Create.
#   4. Copy the 16-character password shown (remove spaces) into
#      GMAIL_APP_PASSWORD below. Google only shows it once.
GMAIL_USER="yourname@gmail.com"
GMAIL_APP_PASSWORD="MY_16_CHAR_APP_PASSWORD"
